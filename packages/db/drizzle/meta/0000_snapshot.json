  "views": {
    "public.response_quality": {
      "columns": {
        "response_id": {
          "name": "response_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "weighted_score": {
          "name": "weighted_score",
          "type": "numeric",
          "primaryKey": false,
          "notNull": false
        },
        "criteria_scored": {
          "name": "criteria_scored",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  SELECT\n    s.response_id AS response_id,\n    SUM(s.score * rc.weight) / NULLIF(SUM(rc.weight), 0) AS weighted_score,\n    COUNT(*)::int AS criteria_scored\n  FROM scores s\n  JOIN rubric_criteria rc ON rc.id = s.rubric_criterion_id\n  GROUP BY s.response_id\n",
      "name": "response_quality",
