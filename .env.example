# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://eval:eval@localhost:5432/llm_eval

# API
PORT=3001
# Comma-separated origins allowed to call the API from a browser.
# Leave unset locally (the Vite proxy keeps requests same-origin); set it to the
# deployed dashboard's origin, e.g. https://llm-eval.vercel.app
# WEB_ORIGIN=

# Dashboard (Vite, build-time). Unset locally so requests stay relative and the
# dev proxy forwards them; in a deployed build point it at the API including the
# /api prefix, e.g. https://llm-eval-api.onrender.com/api
# VITE_API_URL=

# Providers — phased rollout.
# Gemini free tier is enabled first; OpenAI/Anthropic are deferred (rows seeded disabled).
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
